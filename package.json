{
  "name": "template",
  "version": "1.0.0",
  "description": "template voor bootstrap",
  "main": "index.js",
  "author": "Jelle Dhooghe",
  "license": "ISC",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "comp-css": "sass scss/main.scss scss/main.css && postcss --use autoprefixer -r scss/main.css scss/main.css && css-minify -f scss/main.css -o scss",
    "comp-js": "rollup js/main.js --file ./js/bundle.js --format cjs && terser ./js/bundle.js -c -m -o ./js/main.min.js",
    "comp-all": "npm-run-all comp-css comp-js",
    "purge-css": "purgecss --keyframes --css css/main.min.css --content ./*.html \"node_modules/bootstrap/js/dist/{util,modal}.js\" --output css/"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.8",
    "css-minify": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.16",
    "postcss-cli": "^10.0.0",
    "purgecss": "^4.1.3",
    "rollup": "^2.79.0",
    "terser": "^5.15.0"
  }
}
